standards <- tibble(
sample_ID = c("Standard 1", "Standard 2", "Standard 3", "Standard 4", "Standard 5"),
SO4_std_conc = c(0.5, 1.0, 2.0, 10, 20),  #ug/mL
Cl_std_conc = c(5, 10, 20, 100, 200))     #ug/mL
#Spike concentration calc
#spike for these samples was 10uL of the 250 µg/mL standard
spk_std <- (250/s_mw)         # mM of SO4 calculated from 250 ug/mL SO4 spike solution
spkvol <- 10                  # uL volume of spike added
spkvol <- spkvol/Con1         # L volume of spike added
spk_Conc <- (spk_std)*spkvol  # mmoles of SO4 added to each spiked sample
#Top standard Concentrations- Update if running different standard curve:
top_std_cl = 200   #ug/mL
top_std_so4 = 20   #ug/mL
##Read in metadata
metadata <- read.csv(Metadata)
## Pull in metadata and viz code
# Save the existing chunk registry
original_code <- knitr::knit_code$get()
# Temporarily clear registered code
knitr::knit_code$restore()
# Extract the external Rmd
external_code <- knitr::purl(
viz_script,
output = tempfile(fileext = ".R"),
documentation = 2,
quiet = TRUE
)
# Register external chunks in the temporary registry
knitr::read_chunk(external_code)
# Save extracted external chunks
external_chunks <- knitr::knit_code$get()
# Restore the main Rmd's chunks
knitr::knit_code$restore()
do.call(knitr::knit_code$set, original_code)
# Register or replace external chunks
do.call(knitr::knit_code$set, external_chunks)
##Pulls in Project-Specific Metadata cleaning chunk
code <- knitr::knit_code$get("clean_metadata")
eval(parse(text = code))
kable(IDs_to_change)
print(samples_to_remove)
##Import Sample Data
## Read in raw data file from Dionex - copied and saved as a txt
#Sulfate
Sdat <- read.table(raw_file_name_so4, sep='\t' , header=T, skip=3)
Sdat_clean <- Sdat %>%
select(
sample_name = X.1,
sample_ID = X.1,
sample_type = X.2,
SO4_ppm = IC.SO4.1,
SO4_area = IC.SO4.3
) %>%
group_by(sample_name) %>%
mutate(sample_name = if_else(
sample_name %in% c("Lab Blank", "Standard 1", "Standard 2", "Standard 3", "Standard 4", "Standard 5"),
paste0(sample_name, "_", row_number()),
sample_name
)) %>%
ungroup()
#head(Sdat_clean)
#Chloride
Cldat  <- read.table(raw_file_name_cl, sep='\t' , header=T, skip=3)
Cldat_clean <- Cldat %>%
select(
sample_name = X.1,
sample_ID = X.1,
sample_type = X.2,
Cl_ppm = IC.Cl.1,
Cl_area = IC.Cl.3
) %>%
group_by(sample_name) %>%
mutate(sample_name = if_else(
sample_name %in% c("Lab Blank", "Standard 1", "Standard 2", "Standard 3", "Standard 4", "Standard 5"),
paste0(sample_name, "_", row_number()),
sample_name
)) %>%
ungroup()
#head(Cldat_clean)
## Pull Cl and SO4 data  together:
all_dat_merge <- inner_join(Sdat_clean, Cldat_clean, by = c("sample_name", "sample_ID", "sample_type"))
#Remove any lines that have no sample ID, make n.a. into NAs,
#if there are NAs or zeroes in the SO4 or Cl columns, make them zeros because that means there was no peak detected
all_dat <- all_dat_merge %>%
filter(!is.na(sample_ID) & sample_ID != "") %>%
mutate(across(everything(), ~ na_if(.x, "n.a."))) %>%
mutate(across(c(SO4_ppm, Cl_ppm), as.numeric),
across(c(SO4_area, Cl_area), as.numeric)) %>%
mutate(across(c(SO4_ppm, Cl_ppm), ~ replace_na(.x, 0)),
across(c(SO4_area, Cl_area), ~ replace_na(.x, 0))) %>%
mutate(across(c(SO4_ppm, Cl_ppm), ~ replace(.x, .x<0, 0)),
across(c(SO4_area, Cl_area), ~ replace(.x, .x<0, 0)))
head(all_dat)
##Fix samples entered incorrectly
all_dat <- all_dat %>%
##Remove samples
filter(!sample_ID %in% na.omit(samples_to_remove))  %>%
##Fix samples that were entered incorrectly
left_join(IDs_to_change, by = "sample_ID") %>%
mutate(sample_ID = ifelse(is.na(New_IDs), sample_ID, New_IDs)) %>%
select(-New_IDs)
# Filter standards
stds <- all_dat %>%
filter(grepl("Calibration Standard", sample_type)) %>%
mutate(run_date = Date_Run)
#calculate slope and r2 of cal curves
#Cl curve
lm_results_cl <- stds %>%
group_by(run_date) %>%
do({
model = lm(Cl_area ~ Cl_ppm, data = .)
tidy_model = tidy(model)             # coefficients
glance_model = glance(model)         # model metrics like R²
tibble(
slope = tidy_model$estimate[2],    # coefficient for standard_C_ppm
intercept = tidy_model$estimate[1],
r2 = glance_model$adj.r.squared
)
}) %>%
mutate(
analyte = "Cl",
curve = "Chloride (mg/L)",
top_std_area = max(stds$Cl_area)
)
#SO4 curve
lm_results_s <- stds %>%
group_by(run_date) %>%
do({
model = lm(SO4_area ~ SO4_ppm, data = .)
tidy_model = tidy(model)             # coefficients
glance_model = glance(model)         # model metrics like R²
tibble(
slope = tidy_model$estimate[2],    # coefficient for standard_C_ppm
intercept = tidy_model$estimate[1],
r2 = glance_model$adj.r.squared
)
}) %>%
mutate(
analyte = "SO4",
curve = "SO4 (mg/L)",
top_std_area = max(stds$SO4_area)
)
#put the together in one dataframe to later add to log
Slopes <- rbind(lm_results_cl, lm_results_s)
#store the r2's so they plot on the curve graphs
r2_labels_cl <- stds %>%
group_by(run_date) %>%
summarise(
x_pos = max(Cl_ppm, na.rm = TRUE) * 0.8,
y_pos = max(Cl_area, na.rm = TRUE),
r_squared = round(summary(lm(Cl_area ~ Cl_ppm))$adj.r.squared, 4),
.groups = "drop"
)
r2_labels_so4 <- stds %>%
group_by(run_date) %>%
summarise(
x_pos = max(SO4_ppm, na.rm = TRUE) * 0.8,
y_pos = max(SO4_area, na.rm = TRUE),
r_squared = round(summary(lm(SO4_area ~ SO4_ppm))$adj.r.squared, 4),
.groups = "drop"
)
##Plot standard Curve or Curves
#Cl Curve
Cl_stds_plot <- ggplot(stds, aes(x = Cl_ppm, y = Cl_area)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
facet_wrap(~ run_date) +
geom_text(
data = r2_labels_cl,
aes(x = x_pos, y = y_pos, label = paste0("R2 = ", r_squared)),
inherit.aes = FALSE,
hjust = 1, vjust = 1,
size = 4
) +
labs(
title = "Chloride Std Curve",
x = "Cl Standard Concentration (ppm)",
y = "Peak Area"
) +
theme_bw()
# Cl_stds_plot
#SO4 Curve
SO4_stds_plot <- ggplot(stds, aes(x = SO4_ppm, y = SO4_area)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE, color = "purple") +
facet_wrap(~ run_date) +
geom_text(
data = r2_labels_so4,
aes(x = x_pos, y = y_pos, label = paste0("R2 = ", r_squared)),
inherit.aes = FALSE,
hjust = 1, vjust = 1,
size = 4
) +
labs(
title = "Sulfate Std Curve",
x = "SO4 Standard Concentration (ppm)",
y = "Peak Area"
) +
theme_bw()
# SO4_stds_plot
ggarrange(Cl_stds_plot, SO4_stds_plot, ncol=2, nrow=1, common.legend = TRUE, legend = "bottom")
#compare slopes to previous runs (from log) in order to assess drift
# Read the CSV directly into a data frame
log_raw <- read.csv(Log_url)
log_raw$X <- NULL
#make sure they both have dates in Date format
log_raw$run_date <- as.Date(parse_date_time(log_raw$run_date, orders = c("ymd", "mdy")))
log_raw$analyte <- as.character(log_raw$analyte)
log_raw$curve <- as.character(log_raw$curve)
Slopes$run_date <- as.Date(Slopes$run_date)
# Filter to only rows in Slopes that are NOT already in log (by run_date + analyte)
# new_rows <- anti_join(Slopes, log_raw, by = c("run_date", "analyte"))
##Check that the date you are adding hasn't already been added and if it has then have it ask you if you want to rewrite it
ok <- NULL
if(any(Slopes$run_date %in% log_raw$run_date)) {
message("WARNING: this date ", Date_Run, " already exists in log file")
ok <- askYesNo("Continue, overwriting previous standards data for this date? ")
if(isTRUE(ok)) {
log_raw <- anti_join(log_raw, Slopes, by = c("run_date", "analyte")  )
new_rows <- Slopes
} else { new_rows <- anti_join(Slopes, log_raw, by = c("run_date", "analyte"))}
} else { new_rows <- Slopes }
# Append the new, non-duplicate rows to log
log <- bind_rows(log_raw, new_rows)
##Filter for the past 6 months of data for graphing
log_plotting <- log %>%
filter(run_date %in% tail(sort(unique(run_date)), 20))
#plot the current slopes with the previous slopes
Slopes_chk <- ggplot(log_plotting, aes(run_date, slope, col=curve)) +
geom_point(size=4) +
geom_point(data = log %>% filter(run_date %in% Date_Run),color = "black", size=6, shape=8) +
geom_point(data = log %>% filter(run_date %in% Date_Run),color = "black", size=4) +
geom_line() +
theme_bw() + labs(title="Slope Drift Assessment", x="Run Date", y="Slope") +
scale_color_manual(values=c("blue", "purple"))
Slopes_chk
#plot the current top standard areas with the previous areas
areas_chk <- ggplot(log_plotting, aes(run_date, top_std_area, col=curve)) +
geom_point(size=4) +
geom_point(data = log %>% filter(run_date %in% Date_Run),color = "black", size=6, shape=8) +
geom_point(data = log %>% filter(run_date %in% Date_Run),color = "black", size=4) +
geom_line() +
theme_bw() + labs(title="Top STD Area Drift Assessment", x="Run Date", y="Area of Top Standard") +
scale_color_manual(values=c("blue", "purple"))
areas_chk
#Grab the highest r2 that is available for this run
r2_Cl = max(lm_results_cl$r2)
r2_SO4 = max(lm_results_s$r2)
#Write out to the user whether or not the r2 is above the cutoff
ifelse(r2_Cl <= r2_cutoff,
"REASSESS - Cl Curve r2 is below cutoff!", "PROCEED - Cl Curve r2 GOOD")
ifelse(r2_SO4 <= r2_cutoff,
"REASSESS - SO4 Curve r2 is below cutoff!", "PROCEED - SO4 Curve r2 GOOD")
#write out a flag to the sample dataframe if the r2 is above the cutoff of 0.98
all_dat <- all_dat %>%
mutate(
Cl_QAQC_flag = if (r2_Cl <= r2_cutoff) {
"Cl r2 low"
} else {
""
},
SO4_QAQC_flag = if (r2_SO4 <= r2_cutoff) {
"SO4 r2 low"
} else {
""
}
)
##Check that slopes and intercepts are within 2 sd of previous ones
log_avgs <- log %>%
filter(run_date != Date_Run) %>%
group_by(analyte) %>%
summarize(mean_slope = mean(slope, na.rm = TRUE),
sd_slope = sd(slope, na.rm = TRUE),
mean_intercept = mean(intercept, na.rm = TRUE),
sd_intercept = sd(intercept, na.rm = TRUE)) %>%
mutate(slope_lower_limit = mean_slope - 2*sd_slope,
slope_upper_limit = mean_slope + 2*sd_slope,
intercept_lower_limit = mean_intercept - 2*sd_intercept,
intercept_upper_limit = mean_intercept + 2*sd_intercept) %>%
ungroup()
curve_comparison <- Slopes %>%
left_join(log_avgs, by = "analyte") %>%
mutate(slope_flag = case_when(
is.na(sd_slope) ~ "No previous slopes",
slope < slope_lower_limit | slope > slope_upper_limit ~ "REASSESS - Slope is greater than 2 sd of previous slopes",
TRUE ~ "PROCEED - Slope is within 2 sd of previous slopes")) %>%
mutate(intercept_flag = case_when(
is.na(sd_intercept) ~ "No previous intercepts",
intercept < intercept_lower_limit | intercept > intercept_upper_limit ~ "REASSESS - Intercept is greater than 2 sd of previous intercepts",
TRUE ~ "PROCEED - Intercept is within 2 sd of previous intercepts"))
# View results
knitr::kable(
curve_comparison %>% dplyr::select("analyte", "slope_flag", "intercept_flag"),
row.names = FALSE,
digits = 3,
align = "c"
)
# Pull out check standards
chks_raw <- all_dat %>%
filter(grepl("Standard", sample_type))%>%
mutate(rep = row_number())
#Cl standards
chks_Cl <- chks_raw %>%
group_by(sample_ID) %>%
summarise(
mean_Cl = mean(Cl_ppm, na.rm = TRUE),
sd_Cl = sd(Cl_ppm, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
cv_Cl = (sd_Cl / mean_Cl),
flag_Cl = ifelse(cv_Cl < chk_flag_std_cl, "PROCEED - Chloride Check Standard RSD within Range", "REASSESS - Chloride CHECK STANDARD RSD TOO HIGH")
)
#SO4 standards
chks_S <- chks_raw %>%
group_by(sample_ID) %>%
summarise(
mean_SO4 = mean(SO4_ppm, na.rm = TRUE),
sd_SO4 = sd(SO4_ppm, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
cv_SO4 = (sd_SO4 / mean_SO4),
flag_SO4 = ifelse(cv_SO4 < chk_flag_std_s, "PROCEED - Sulfate Check Standard RSD within Range", "REASSESS - Sulfate CHECK STANDARD RSD TOO HIGH")
)
# View results
knitr::kable(
chks_Cl %>% dplyr::select(-sd_Cl),
row.names = FALSE,
digits = 3,
align = "c"
)
knitr::kable(
chks_S %>% dplyr::select(-sd_SO4),
row.names = FALSE,
digits = 3,
align = "c"
)
#calculate the percent of check standards that have high cv's based on the flag
cl_chks_percent_cv <- (sum(chks_Cl$flag_Cl == "PROCEED - Chloride Check Standard RSD within Range")/nrow(chks_Cl))*100
so4_chks_percent_cv <- (sum(chks_S$flag_SO4 == "PROCEED - Sulfate Check Standard RSD within Range")/nrow(chks_S))*100
#report out if flags indicate need for rerun
ifelse(cl_chks_percent_cv >= chks_flag, "PROCEED - >80% of Chloride Check Standards have RSD within range",
"REASSESS - <80% of Chloride Check Standards have RSD within range")
ifelse(so4_chks_percent_cv >= chks_flag,"PROCEED - >80% of Sulfate Check Standards have RSD within range",
"REASSESS - <80% of Sulfate Check Standards have RSD within range")
#write out a flag to the sample dataframe if less than 80% of the check standard RSD's are within range
if (cl_chks_percent_cv <= chks_flag) {
all_dat$Cl_QAQC_flag <- ifelse(
all_dat$Cl_QAQC_flag != "",
paste0(all_dat$Cl_QAQC_flag, "; Cl checks RSD out of range"),
"Cl checks RSD out of range"
)
}
if (so4_chks_percent_cv <= chks_flag) {
all_dat$SO4_QAQC_flag <- ifelse(
all_dat$SO4_QAQC_flag != "",
paste0(all_dat$SO4_QAQC_flag, "; SO4 checks RSD out of range"),
"SO4 checks RSD out of range"
)
}
##Add in the expected concentrations
chks_merged <- left_join(chks_raw, standards, by = "sample_ID")
##Order by standard concentration and add rep numbers
chks_merged <- chks_merged[order(chks_merged$SO4_std_conc, chks_merged$Cl_std_conc), ]
chks_merged <- chks_merged %>%
mutate(rep = row_number())
#calculate percent difference between check standards & expected concentration
chks_merged$Cl_diff <- (abs(chks_merged$Cl_ppm - chks_merged$Cl_std_conc)/((chks_merged$Cl_ppm + chks_merged$Cl_std_conc)/2)) * 100
chks_merged$Cl_diff_flag <-  ifelse(chks_merged$Cl_diff <= chk_flag_std_perc, 'Passed check', 'Failed check')
chks_merged$SO4_diff <- (abs(chks_merged$SO4_ppm - chks_merged$SO4_std_conc)/((chks_merged$SO4_ppm + chks_merged$SO4_std_conc)/2)) * 100
chks_merged$SO4_diff_flag <-  ifelse(chks_merged$SO4_diff <= chk_flag_std_perc, 'Passed check', 'Failed check')
#Plot the check standards vs. the expected concentration
##Maybe arrange by standard number and add horizontal lines to graphs showing where the expected concentration is?
custom_y_breaks_Cl <- standards$Cl_std_conc
custom_y_labels_Cl <- standards$sample_ID
cl_chks <-  ggplot(data = chks_merged, aes(x = rep, y = Cl_ppm, fill=Cl_diff_flag)) +
geom_bar(stat = 'identity') +
scale_fill_manual(values = c("Passed check" = "blue", "Failed check" = "darkred")) +
theme_classic() + labs(x= " ", y="Cl (ppm)", title="Check Stds: Chloride") +
theme(legend.position="bottom") +
geom_hline(yintercept=standards$Cl_std_conc, linetype="dashed", color = "black", linewidth=1) +
scale_y_continuous(breaks = custom_y_breaks_Cl, labels = custom_y_labels_Cl) +
guides(fill=guide_legend(title="% Difference <10%")) +
labs(fill = "Check Standard flag")
custom_y_breaks_SO4 <- standards$SO4_std_conc
custom_y_labels_SO4 <- standards$sample_ID
so4_chks <-  ggplot(data = chks_merged, aes(x = rep, y = SO4_ppm, fill=SO4_diff_flag)) +
geom_bar(stat = 'identity') +
scale_fill_manual(values = c("Passed check" = "blue", "Failed check" = "darkred")) +
theme_classic() + labs(x= " ", y="SO4  (ppm)", title="Check Stds: Sulfate") +
theme(legend.position="bottom") +
scale_y_continuous(breaks = custom_y_breaks_SO4, labels = custom_y_labels_SO4) +
geom_hline(yintercept=standards$SO4_std_conc,linetype="dashed",  color = "black", linewidth=1) +
guides(fill=guide_legend(title="% Difference <10%")) +
labs(fill = "Check Standard flag")
ggarrange(cl_chks, so4_chks, nrow=1, ncol=2, common.legend = TRUE, legend = "bottom")
#calculate the percent of check standards that are within the range based on the flag
cl_chks_percent <- (sum(chks_merged$Cl_diff_flag == "Passed check")/nrow(chks_merged))*100
so4_chks_percent <- (sum(chks_merged$SO4_diff_flag == "Passed check")/nrow(chks_merged))*100
#report out if flags indicate need for rerun
ifelse(cl_chks_percent >= chks_flag, "PROCEED - >80% of Chloride Check Standards are within range of expected concentration",
"REASSESS - <80% of Chloride Check Standards are within range of expected concentration")
ifelse(so4_chks_percent >= chks_flag,"PROCEED - >80% of Sulfate Check Standards are within range of expected concentration",
"REASSESS - <80% of Sulfate Check Standards are within range of expected concentration")
#write out a flag to the sample dataframe if less than 80% of the checks are within range of expected concentration
if (cl_chks_percent <= chks_flag) {
all_dat$Cl_QAQC_flag <- ifelse(
all_dat$Cl_QAQC_flag != "",
paste0(all_dat$Cl_QAQC_flag, "; Cl checks perc diff out of range"),
"Cl checks perc diff out of range"
)
}
if (so4_chks_percent <= chks_flag) {
all_dat$SO4_QAQC_flag <- ifelse(
all_dat$SO4_QAQC_flag != "",
paste0(all_dat$SO4_QAQC_flag, "; SO4 checks perc diff out of range"),
"SO4 checks perc diff out of range"
)
}
#Pull out the blanks from raw file
blks_raw <- all_dat %>%
filter(grepl("Lab Blank", sample_ID))
blks_raw <- blks_raw %>%
mutate(rep = row_number())
#Check if the blanks are above the lower 25% quantile of your data
blk_flag_cl <- quantile(all_dat$Cl_ppm, prob=c(.25))   #this gives you the lower 25% quantile of the data
blks_raw$Cl_diff_flag <-  ifelse(blks_raw$Cl_ppm <= blk_flag_cl, 'Passed check', 'Failed check')
blk_flag_so4 <- quantile(all_dat$SO4_ppm, prob=c(.25))   #this gives you the lower 25% quantile of the data
blks_raw$so4_diff_flag <-  ifelse(blks_raw$SO4_ppm <= blk_flag_so4, 'Passed check', 'Failed check')
#calculate the percent of check standards that are within the range based on the flag
cl_blks_percent <- (sum(blks_raw$Cl_diff_flag == "Passed check")/nrow(blks_raw))*100
so4_blks_percent <- (sum(blks_raw$so4_diff_flag == "Passed check")/nrow(blks_raw))*100
#Plot the blanks vs. the lower 25% quantile of your data in this run (black line)
cl_blks <-  ggplot(data = blks_raw, aes(x = rep, y = Cl_ppm, fill=Cl_diff_flag)) +
geom_bar(stat = 'identity') +
scale_fill_manual(values = c("Passed check" = "darkblue", "Failed check" = "darkgrey")) +
theme_classic() +
labs(x= " ", y="Cl  (mg/L)", title="Blanks: Chloride") +
theme(legend.position="bottom") +
geom_hline(yintercept=blk_flag_cl, linetype="dashed", color = "black", linewidth=1)  +
guides(fill=guide_legend(title="Blank Conc <25% Quartile Samples")) +
geom_text(aes(x = max(rep), y = blk_flag_cl, label = "Lower 25% of data"),
vjust = -0.8,       # Moves text slightly above the line
hjust = 1,          # Right-aligns text at the x-position
color = "darkred") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
labs(fill = "Blank flag") +
geom_text(aes(label = ifelse(Cl_ppm == 0, "0", "")), vjust = -0.5)
so4_blks <-  ggplot(data = blks_raw, aes(x = rep, y = SO4_ppm, fill=so4_diff_flag)) +
geom_bar(stat = 'identity') +
scale_fill_manual(values = c("Passed check" = "darkblue", "Failed check" = "darkgrey")) +
theme_classic() +
labs(x= " ", y="SO4  (mg/L)", title="Blanks: Sulfate") +
theme(legend.position="bottom") +
geom_hline(yintercept=blk_flag_so4, linetype="dashed", color = "black", linewidth=1)  +
guides(fill=guide_legend(title="Blank Conc <25% Quartile Samples")) +
geom_text(aes(x = max(rep), y = blk_flag_so4, label = "Lower 25% of data"),
vjust = -0.8,       # Moves text slightly above the line
hjust = 1,          # Right-aligns text at the x-position
color = "darkred") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
labs(fill = "Blank flag") +
geom_text(aes(label = ifelse(SO4_ppm == 0, "0", "")), vjust = -0.5)
ggarrange(cl_blks, so4_blks, nrow=1, ncol=2, common.legend = TRUE, legend = "bottom")
ggarrange(cl_blks, so4_blks, nrow=1, ncol=2, common.legend = TRUE, legend = "bottom")
#print out the average blank concentrations
blk_avg_cl <- data.frame(
analyte = "Cl",
run_date = Date_Run,
mean_blanks = mean(blks_raw$Cl_ppm)
)
#print out the average blank concentrations
blk_avg_cl <- data.frame(
analyte = "Cl",
run_date = Date_Run,
mean_blanks = mean(blks_raw$Cl_ppm)
)
blk_avg_so4 <- data.frame(
analyte = "SO4",
run_date = Date_Run,
mean_blanks = mean(blks_raw$SO4_ppm)
)
blk_avgs <- bind_rows(blk_avg_cl, blk_avg_so4)
knitr::kable(
blk_avgs,
row.names = FALSE,
digits = 3,
align = "c"
)
View(blk_avgs)
knitr::kable(
blk_avgs,
row.names = FALSE,
digits = 3,
align = "c"
)
##Add blank concentrations to log, write over previous one for that run date and analyte
if (!"mean_blanks" %in% names(log)) {
log$mean_blanks <- NA_real_
}
log <- log %>%
rows_update(
blk_avgs,
by = c("run_date", "analyte")
)
log <- rows_update(
