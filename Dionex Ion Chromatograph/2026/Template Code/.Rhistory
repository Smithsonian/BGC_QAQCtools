Script_run_by = "Zoe Read" #Code user
run_notes = "Run notes" #any notes from the run
sample_month = "May"
sample_year = "2026"
Project_name <- "COMPASS:Synoptic" #CO2xN/SMARTX/GENX/COMPASS:TEMPEST/COMPASS:Synoptic/CO2xNxPhrag/CO2xCOMM/GENX
Site <- c("GCW", "GWI", "MSM", "SWH") #whatever identifies your samples within the same names (TMP, FATE, "GWI", "MSM", "SWH"); Use "GCW" for LTREB site
Site_pattern <- paste(Site, collapse = "|")
Plot <- c("UP", "TR", "SWAMP", "WC", "SW") ##Use "ALL" for LTREB sample plots, for COMPASS: "UP", "TR", "SWAMP", "WC", "SW"
Plot_pattern <- paste(Plot, collapse = "|")
#Set time zone
common_tz = "Etc/GMT+5"
Sys.setenv(TZ = "America/New_York")
##Fix samples that were entered incorrectly - PLEASE CHANGE
#Enter samples to remove
samples_to_remove <- c("5","6")
#Enter IDs to change
sample_ID <- c("1", "2")
New_IDs <- c("3", "4")
IDs_to_change <- data.frame(sample_ID, New_IDs)
##### Project-specific R Scripts ####
viz_script <- "Dionex_metadata_and_viz_COMPASS_Synoptic.Rmd"
###### File Names - PLEASE CHANGE
#file path and name for raw summary data file
raw_file_name_cl = "Raw Data/COMPASS_Synoptic_CB_MonMon_202607_MSM_GWI_Cl.txt"
raw_file_name_so4 = "Raw Data/COMPASS_Synoptic_CB_MonMon_202607_MSM_GWI_SO4.txt"
#file path and name of processed data file
processed_file_name = "Processed Data/COMPASS_SynopticCB_PW_Processed_Cl_SO4_202607.csv"
###### Log Files - PLEASE CHECK
#downloaded metadata csv - downloaded from Google drive as csv for this year
Metadata = "Raw Data/COMPASS_SynopticCB_PW_SampleLog_2026.csv"
#Dilutions table
Dilutions_url <-  "https://raw.githubusercontent.com/Smithsonian/BGC_QAQCtools/refs/heads/main/Dionex%20Ion%20Chromatograph/2026/Dionex_Dilution_Lookup_Table.csv"
#Qaqc log file path for this year
# Read directly from GitHub page
# Paste your raw URL inside the quotes
Log_url <- "https://raw.githubusercontent.com/Smithsonian/BGC_QAQCtools/refs/heads/main/Dionex%20Ion%20Chromatograph/2026/Dionex_QAQClog_2026.csv"
Log_path <- "Dionex_QAQClog_2026.csv"
#1.Clone this GitHub: https://github.com/Smithsonian/BGC_QAQCtools
#2.Open R environment
# usethis::edit_r_environ()
#3.Only need to do this once ever: Enter this with path to your cloned BGC_QAQCtools repo on your computer: BGC_QAQCtools_REPO_PATH=Path/to/BGC_QAQCtools
#4.Restart R
#5.Create actual log path
BGC_QAQCtools_repo <- Sys.getenv("BGC_QAQCtools_REPO_PATH")
path_within_repo <- "Dionex Ion Chromatograph/2026/Dionex_QAQClog_2026.csv"
Log_path <- file.path(BGC_QAQCtools_repo, path_within_repo)
##Set Up Code - constants and QAQC cutoffs
#Coefficients / constants that are needed for calculations
cl_mw <- 35.45     #molecular weight of Chloride, g/mol
s_mw <- 32.06      #molecular weight of sulfur, g/mol
Con1 <- 1000000    #conversion factor value for spike volumes (uL -> L)
#Flag cutoffs
r2_cutoff = 0.98            #this is the level below which we want to rerun or consider a curve
chk_flag_std_s = 10         #this is the maximum cv allowed for sulfate check standards
chk_flag_std_cl = 5         #this is the maximum cv allowed for chloride check standards
chk_flag_std_perc = 15      #this is the maximum perc diff allowed for check standards
chk_flag_dups = 10          #this is the maximum cv allowed for duplicates
high_recovery_cutoff = 120  #this is the maximum percent recovery of SO4 allowed in spiked samples
low_recovery_cutoff = 80    #this is the minimum percent recovery of SO4 allowed in spiked samples
chks_flag = 80              #if less than this percent of samples pass a check, a flag is added
#Standard concentrations - Update if running different standard curve:
standards <- tibble(
sample_ID = c("Standard 1", "Standard 2", "Standard 3", "Standard 4", "Standard 5"),
SO4_std_conc = c(0.5, 1.0, 2.0, 10, 20),  #ug/mL
Cl_std_conc = c(5, 10, 20, 100, 200))     #ug/mL
#Spike concentration calc
#spike for these samples was 10uL of the 250 µg/mL standard
spk_std <- (250/s_mw)         # mM of SO4 calculated from 250 ug/mL SO4 spike solution
spkvol <- 10                  # uL volume of spike added
spkvol <- spkvol/Con1         # L volume of spike added
spk_Conc <- (spk_std)*spkvol  # mmoles of SO4 added to each spiked sample
#Top standard Concentrations- Update if running different standard curve:
top_std_cl = 200   #ug/mL
top_std_so4 = 20   #ug/mL
##Read in metadata
metadata <- read.csv(Metadata)
##Pulls in Project-Specific Metadata cleaning chunk
external_code <- knitr::purl(
viz_script,
output = tempfile(fileext = ".R"),
documentation = 2)
